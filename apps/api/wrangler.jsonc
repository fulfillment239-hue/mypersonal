{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "462019-content-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-10",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    { "binding": "DB", "database_name": "462019-portfolio", "database_id": "85462e43-e9d1-4e0e-977e-301f7a0edf55", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "CONTENT", "bucket_name": "462019-portfolio-content" }
  ],
  "vars": {
    "APP_ORIGIN": "https://462019.xyz",
    "ENVIRONMENT": "production"
  }
}
