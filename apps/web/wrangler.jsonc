{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mypersonal1",
  "main": "src/worker.ts",
  "compatibility_date": "2025-04-10",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "462019.xyz", "custom_domain": true },
    { "pattern": "www.462019.xyz", "custom_domain": true }
  ],
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  "services": [ { "binding": "API", "service": "462019-content-api" } ]
}
