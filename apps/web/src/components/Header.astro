---
/** Fixed navigation keeps public work, language and account actions reachable. */
import type { Locale } from "@462019/contracts";
import { localePath } from "../lib";
import AuthDialog from "./AuthDialog";

const { locale, localeHref } = Astro.props as { locale: Locale; localeHref: string };
const labels = locale === "en" ? { works: "Works", about: "Statement", account: "Sign in" } : { works: "作品", about: "陈述", account: "登录" };
const targetLocale = locale === "en" ? "zh-CN" : "en";
---
<header class="header">
  <div class="shell header__row">
    <a class="brand" href={localePath(locale)} aria-label="462019 home"><span>462019</span><small>ARCHIVE</small></a>
    <nav class="nav" aria-label={locale === "en" ? "Primary navigation" : "主导航"}>
      <a href={localePath(locale, "works")}>{labels.works}</a>
      <a href={localePath(locale, "#statement")}>{labels.about}</a>
      <a class="nav__locale" href={localeHref} lang={targetLocale} hreflang={targetLocale} data-locale-switch data-astro-history="replace" aria-label={locale === "en" ? "切换为简体中文" : "Switch to English"}>{locale === "en" ? "简中" : "EN"}</a>
      <AuthDialog client:load label={labels.account} locale={locale} />
    </nav>
  </div>
</header>

<script>
  /* Client-side locale swaps replace the bands, so every page load refreshes the observed nodes. */
  function watchHeaderBands(): () => void {
    const header = document.querySelector<HTMLElement>(".header");
    const bands = Array.from(document.querySelectorAll<HTMLElement>(".section--paper"));
    if (!header) return () => undefined;

    const probe = () => {
      const y = header.getBoundingClientRect().height * 0.55;
      const onLinen = bands.some((band) => {
        const box = band.getBoundingClientRect();
        return box.top <= y && box.bottom >= y;
      });
      header.classList.toggle("header--paper", onLinen);
    };
    let queued = false;
    const schedule = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => { queued = false; probe(); });
    };
    addEventListener("scroll", schedule, { passive: true });
    addEventListener("resize", schedule);
    probe();

    return () => {
      removeEventListener("scroll", schedule);
      removeEventListener("resize", schedule);
    };
  }

  function watchVisibility(): () => void {
    const follow = () => document.body.classList.toggle("paused", document.hidden);
    document.addEventListener("visibilitychange", follow);
    follow();
    return () => document.removeEventListener("visibilitychange", follow);
  }

  let stop = () => undefined;
  const start = () => {
    stop();
    const stopBands = watchHeaderBands();
    const stopVisibility = watchVisibility();
    stop = () => { stopBands(); stopVisibility(); };
  };

  document.addEventListener("astro:page-load", start);
  start();
</script>
