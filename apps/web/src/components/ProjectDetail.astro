---
/** Project details render only controlled Markdown text and never raw content HTML. */
import type { Locale, Project } from "@462019/contracts";
import { copy } from "../lib";
interface Props { locale: Locale; project: Project; categoryName: string; }
const { locale, project, categoryName } = Astro.props;
const body = copy(locale, project.bodyMarkdown).replace(/^###\s+/gm, "").split(/\n\n+/).filter(Boolean);
const labels = locale === "en" ? { role: "Role", tools: "Tools", back: "Back to archive" } : { role: "职责", tools: "工具", back: "返回档案" };
---
<article class="detail"><div class="shell">
  <div class="detail__intro"><a class="eyebrow" href={locale === "en" ? "/works" : "/zh-cn/works"}>← {labels.back}</a><p class="eyebrow" style={`color:${project.accent}`}>{categoryName} / {project.year}</p><h1>{copy(locale, project.title)}</h1><p>{copy(locale, project.summary)}</p>{project.isDemo && <span class="demo">{locale === "en" ? "Sample project, replace it in administration" : "示例项目，可在管理后台中替换"}</span>}</div>
  {project.cover && <picture class="detail__cover"><source type="image/avif" srcset={`${project.cover.basePath}-960.avif 960w, ${project.cover.basePath}-1440.avif 1440w`} sizes="min(1180px, calc(100vw - 3rem))" /><source type="image/webp" srcset={`${project.cover.basePath}-960.webp 960w, ${project.cover.basePath}-1440.webp 1440w`} sizes="min(1180px, calc(100vw - 3rem))" /><img src={`${project.cover.basePath}-1440.webp`} alt={copy(locale, project.cover.alt)} width={project.cover.width} height={project.cover.height} decoding="async" /></picture>}
  <div class="detail__body"><aside><p><strong>{labels.role}</strong><br />{project.roles.join(" · ")}</p><p><strong>{labels.tools}</strong><br />{project.technologies.join(" · ")}</p></aside><div class="markdown">{body.map((paragraph) => <p>{paragraph}</p>)}</div></div>
</div></article>
