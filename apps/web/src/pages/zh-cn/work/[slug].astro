---
/** Simplified Chinese project pages share locale-neutral project slugs. */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ProjectDetail from "../../../components/ProjectDetail.astro";
import { seededCategories, seededProjects } from "@462019/content";
export function getStaticPaths() { return seededProjects.filter((project) => project.status === "published").map((project) => ({ params: { slug: project.slug } })); }
const project = seededProjects.find((item) => item.slug === Astro.params.slug);
const category = seededCategories.find((item) => item.id === project?.categoryId);
if (!project || !category) return Astro.redirect("/zh-cn/works");
---
<BaseLayout locale="zh-CN" title={`${project.title["zh-CN"]} — 462019`} description={project.summary["zh-CN"]}><ProjectDetail locale="zh-CN" project={project} categoryName={category.label["zh-CN"]} /></BaseLayout>
