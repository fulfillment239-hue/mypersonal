---
/** Fixed navigation keeps public work, language and account actions reachable. */
import type { Locale } from "@462019/contracts";
import { localePath } from "../lib";
import AuthDialog from "./AuthDialog";

const { locale } = Astro.props as { locale: Locale };
const labels = locale === "en" ? { works: "Works", about: "Statement", account: "Sign in" } : { works: "作品", about: "陈述", account: "登录" };
const targetLocale = locale === "en" ? "zh-CN" : "en";
---
<header class="header">
  <div class="shell header__row">
    <a class="brand" href={localePath(locale)} aria-label="462019 home"><span>462019</span><small>ARCHIVE</small></a>
    <nav class="nav" aria-label={locale === "en" ? "Primary navigation" : "主导航"}>
      <a href={localePath(locale, "works")}>{labels.works}</a>
      <a href={localePath(locale, "#statement")}>{labels.about}</a>
      <a class="nav__locale" href={localePath(targetLocale)} lang={targetLocale}>{locale === "en" ? "简中" : "EN"}</a>
      <AuthDialog client:load label={labels.account} locale={locale} />
    </nav>
  </div>
</header>

<script>
  /* The fixed bar crosses linen bands where its dark text disappears, so it watches what is behind it. */
  const header = document.querySelector<HTMLElement>(".header");
  const bands = Array.from(document.querySelectorAll<HTMLElement>(".section--paper"));
  if (header && bands.length) {
    const probe = () => {
      const y = header.getBoundingClientRect().height * 0.55;
      const onLinen = bands.some((band) => {
        const box = band.getBoundingClientRect();
        return box.top <= y && box.bottom >= y;
      });
      header.classList.toggle("header--paper", onLinen);
    };
    let queued = false;
    const schedule = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => { queued = false; probe(); });
    };
    addEventListener("scroll", schedule, { passive: true });
    addEventListener("resize", schedule);
    probe();
  }

  /* Nothing should keep animating in a tab nobody is looking at. */
  const followVisibility = () => document.body.classList.toggle("paused", document.hidden);
  document.addEventListener("visibilitychange", followVisibility);
  followVisibility();
</script>
