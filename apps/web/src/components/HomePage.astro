---
/** Home composition turns R2-compatible seeded content into the public exhibition flow. */
import type { Category, Locale, Project, SiteContent } from "@462019/contracts";
import { copy, projectPath } from "../lib";
import HeroStage from "./HeroStage";
import ProjectPreview from "./ProjectPreview.astro";

interface Props { locale: Locale; site: SiteContent; categories: Category[]; projects: Project[]; }
const { locale, site, categories, projects } = Astro.props;
const categoryById = new Map(categories.map((category) => [category.id, category]));
const words = locale === "en"
  ? { works: "Selected work", worksBody: "Interface studies shaped through art direction, careful editing and functional restraint.", caseStudy: "Case study", scroll: "Scroll to explore", statement: "Statement", contact: "Contact", view: "View case study" }
  : { works: "精选作品", worksBody: "以艺术指导、审慎取舍与功能克制塑造的界面设计研究。", caseStudy: "作品案例", scroll: "向下探索", statement: "创作陈述", contact: "联系", view: "查看案例" };
---
<HeroStage client:load kicker={copy(locale, site.heroKicker)} title={copy(locale, site.heroTitle)} description={copy(locale, site.heroDescription)} scrollLabel={words.scroll} />

<section id="works" class="section section--paper" data-reveal>
  <div class="shell">
    <div class="section__heading">
      <div class="eyebrow">01 / {words.works}</div>
      <h2>{words.works}</h2>
      <p>{words.worksBody}</p>
    </div>
    <div class="project-grid">
      {projects.filter((project) => project.featured && project.status === "published").map((project, index) => <a class="project" href={projectPath(locale, project)} style={`--accent:${project.accent}`}>
        <ProjectPreview locale={locale} project={project} index={index} categoryName={copy(locale, categoryById.get(project.categoryId)?.label ?? { en: "Work", "zh-CN": "作品" })} />
        <div>
          <div class="project__meta"><span>{project.year}</span><span>{project.isDemo ? "Sample" : words.caseStudy}</span></div>
          <h3>{copy(locale, project.title)}</h3>
          <p>{copy(locale, project.summary)}</p>
          <div class="project__tags">{project.roles.slice(0, 2).map((role) => <span>{role}</span>)}</div>
          <span class="project__link">{words.view} <b aria-hidden="true">↗</b></span>
          {project.isDemo && <span class="demo">{locale === "en" ? "Sample record" : "示例记录"}</span>}
        </div>
      </a>)}
    </div>
  </div>
</section>

<section id="statement" class="section" data-reveal>
  <div class="shell about">
    <div><div class="eyebrow">02 / {words.statement}</div><h2>{copy(locale, site.aboutTitle)}</h2></div>
    <p class="about__copy">{copy(locale, site.aboutBody)}</p>
  </div>
</section>

<section class="section section--paper" data-reveal>
  <div class="shell about">
    <div><div class="eyebrow">03 / {words.contact}</div><h2>{copy(locale, site.contactTitle)}</h2></div>
    <div class="about__copy"><p>{copy(locale, site.contactBody)}</p>{site.contactEmail && <a class="pill" href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>}</div>
  </div>
</section>
